# Shared / infra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=users
MONGO_INITDB_DATABASE=logs
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Front-end (host maps 8088→80 in compose)
BROKER_URL=http://localhost:8080

# Broker
BROKER_PORT=80
AUTH_URL=http://authentication-service/authenticate
LOGGER_HTTP_URL=http://logger-service/log
LOGGER_RPC_ADDR=logger-service:5001
LOGGER_GRPC_ADDR=logger-service:50001
MAIL_URL=http://mail-service/send
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
HTTP_CLIENT_TIMEOUT=10s
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# Authentication
AUTH_PORT=80
DSN=host=postgres port=5432 user=postgres password=password dbname=users sslmode=disable timezone=UTC connect_timeout=5
DB_MAX_RETRIES=10

# Logger
LOGGER_PORT=80
RPC_PORT=5001
GRPC_PORT=50001
MONGO_URL=mongodb://mongo:27017
MONGO_USER=admin
MONGO_PASSWORD=password
MONGO_DB=logs
MONGO_COLLECTION=logs

# Mail
MAIL_PORT_HTTP=80
MAIL_DOMAIN=localhost
MAIL_HOST=mailhog
MAIL_ENCRYPTION=none
MAIL_SMTP_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Go Micro
MAIL_FROM_ADDRESS=noreply@go-micro.local
TEMPLATES_DIR=/templates

# Listener
LOGGER_HTTP_URL_LISTENER=http://logger-service/log
